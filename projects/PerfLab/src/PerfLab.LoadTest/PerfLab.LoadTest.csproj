<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBomber" Version="6.5.0" />
    <PackageReference Include="NBomber.Http" Version="6.2.1" />
    <!-- NBomber resolves MessagePack 2.5.302; 2.5.303 contains the security fix. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

</Project>
